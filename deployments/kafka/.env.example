# Копируй этот файл в .env и заполни своими значениями
# .env добавлен в .gitignore, а .env.example - в репозитории

# Обязательные параметры (есть дефолты, но лучше явно указать)
KAFKA_VERSION=4.0
KAFKA_CONTAINER_NAME=kafka-kraft
KAFKA_CLUSTER_ID=AAAAAAAAAAAAAAAAAAAAAQ

# Сетевые параметры (меняй если порты заняты)
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=9091
KAFKA_CONTROLLER_PORT=9093

# Volume для данных (обычно не трогают)
KAFKA_VOLUME_NAME=kafka_data

# Тюнинг (меняй если мало памяти)
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m

# Retention (подстрой под свои задачи)
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_BYTES=10737418240

# Автосоздание топиков (true - для dev, false - для prod)
AUTO_CREATE_TOPICS=false

# Уровень логов (DEBUG для отладки, INFO для обычной работы)
KAFKA_LOG_LEVEL=INFO

# ===== НАСТРОЙКИ KAFKA-UI =====
# Порт для веб-интерфейса (можно изменить, если 8080 занят)
KAFKA_UI_PORT=8080